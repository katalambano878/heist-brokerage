# PostgreSQL (Docker: see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/heist_brokerage?schema=public"

# JWT — must be ≥32 characters (openssl rand -hex 32)
JWT_ACCESS_SECRET="dev-only-access-secret-replace-in-production-32chars-min"
JWT_REFRESH_SECRET="dev-only-refresh-secret-replace-in-production-32chars-min"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# CORS — comma-separated origins (no trailing slashes)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Server
PORT=4000
NODE_ENV=development

# Public base URL of this API (used in uploaded-image URLs)
PUBLIC_API_URL="http://localhost:4000"

# Where uploaded images are written (defaults to ./uploads)
# UPLOAD_DIR=/data/uploads

# Seed admin credentials (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@heistbrokerage.com"
SEED_ADMIN_PASSWORD="HeistAdmin#2026"

# ---------------------------------------------------------------------------
# Email (Resend) — https://resend.com
# Add RESEND_API_KEY once your domain is verified in Resend.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Heist Brokerage <noreply@heistbrokerage.com>"
# SITE_URL="https://www.heistbrokerage.com"
# ADMIN_URL="https://heistbrokerage.com/admin"

# Team inboxes — admin alerts route here automatically
# NOTIFY_EMAIL_CORPORATE="corporate@heistbrokerage.com"
# NOTIFY_EMAIL_HR="hr@heistbrokerage.com"
# NOTIFY_EMAIL_GENERAL="ssamirah@heistbrokerage.com"

# ---------------------------------------------------------------------------
# SMS (Moolre VAS) — same API as our other projects
# Docs: https://docs.moolre.com/#/send-sms
# ---------------------------------------------------------------------------
# MOOLRE_SMS_API_KEY="your-vas-key"
# SMS_SENDER_ID="Heist"
# DEFAULT_COUNTRY_CODE="233"

# Staff mobiles that receive instant SMS alerts (optional)
# NOTIFY_PHONE_CORPORATE="0243889512"
# NOTIFY_PHONE_HR="0203436540"
# NOTIFY_PHONE_GENERAL="0243889512"
